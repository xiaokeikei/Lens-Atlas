# Copy to .env on the NAS. Use actual existing paths. 0.0.0.0 follows NAS address changes.
LENS_MEDIA_PATH=/your/existing/photos
LENS_APP_PATH=/your/existing/lens-atlas-data
LENS_BIND_IP=0.0.0.0
LENS_PORT=52032
LENS_UID=1000
LENS_GID=1000

# Optional, only for compose.registry.yaml after a real image has been published:
# LENS_IMAGE=your-registry/your-account/lens-atlas:0.1.3
